{
  "name": "flaregun",
  "type": "module",
  "version": "6.0.1",
  "description": "JavaScript utils for Cloudflare Workers.",
  "main": "index.js",
  "scripts": {
    "start": "npm install && cf dev",
    "build": "npx -y treeder/flaregun build",
    "run": "cf dev",
    "test:run": "vitest run",
    "test": "vitest run",
    "setup": "npx -y treeder/flaregun setup",
    "deploy": "cf deploy",
    "preview": "cf previews deploy"
  },
  "bin": "./bin/flaregun.js",
  "files": [
    "bin",
    "middleware",
    "d1.js",
    "errors.js",
    "index.js",
    "kv.js",
    "logger.js",
    "scheduler.js",
    "utils.js",
    "worker.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/treeder/flaregun.git"
  },
  "author": "treeder",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/treeder/flaregun/issues"
  },
  "homepage": "https://github.com/treeder/flaregun#readme",
  "dependencies": {
    "api": "github:treeder/api#semver:^1",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "jsonc-parse": "^2.1.0",
    "models": "github:treeder/models#semver:^1",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "cf": "^1.0.0-beta.20",
    "migrations": "github:treeder/migrations#semver:^3",
    "once": "github:treeder/once#semver:^1",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "prettier": {
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 120,
    "bracketSameLine": true
  }
}
